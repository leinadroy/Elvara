# Salin ke .env lalu sesuaikan.
# Database lokal tanpa Docker: `npm run db:up` menjalankan dua server `prisma dev` (smart-school dan smart-school-test)
# lalu menampilkan URL-nya. Port dipilih otomatis saat server pertama kali dibuat dan tetap sama sesudahnya;
# bila berbeda dari nilai di bawah, salin URL dari `npm run db:status -w api`.
PORT=4000
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# `prisma dev` (PGlite) hanya aman dengan 1 koneksi: dengan beberapa koneksi aktif, pesan antar-koneksi tercampur.
# Naikkan (mis. 10) bila memakai PostgreSQL biasa.
DATABASE_POOL_MAX=1
# Database terpisah untuk tes e2e; isinya dikosongkan setiap tes.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Origin Next.js yang boleh memanggil API (CORS), pisahkan dengan koma bila lebih dari satu.
WEB_ORIGIN="http://localhost:3000"
