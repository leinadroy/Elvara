{
  "name": "@smart-school/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Skema validasi (Zod) dan tipe DTO yang dibagi antara web dan API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@smart-school/config": "*",
    "typescript": "^6.0.2"
  }
}
